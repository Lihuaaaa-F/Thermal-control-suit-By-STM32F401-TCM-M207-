# --- 目标芯片（R1 复核 R-13 同类：不钉会在无本地 sdkconfig 时默认 esp32，编错芯片）---
CONFIG_IDF_TARGET="esp32s3"

# ===== S3-N16R8 模板(16MB Flash + 8MB Octal PSRAM + WiFi/BLE)=====
# 复制为工程根 sdkconfig.defaults;改配置只改这里,不手改 sdkconfig 生成物

# --- Flash 16MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM 8MB Octal(R8=八角 SPI;选 QUAD 会探测失败)---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# --- 控制台走 USB-Serial-JTAG(免驱)---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- 自定义分区表(16MB)---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16mb.csv"

# --- WiFi + BLE 共存 ---
CONFIG_ESP_COEX_ENABLED=y

# --- BLE 非目标（任务书 §9），关闭省 RAM/编译时间 ---
CONFIG_BT_ENABLED=n

# --- HTTP Server WebSocket（/ws 推送）---
CONFIG_HTTPD_WS_SUPPORT=y
# 握手完成后要回调到本模块：不打开的话 httpd 握手成功后**不调用** URI 处理函数，
# 客户端永远登记不进表、收不到任何推送与回执（2026-11-24 真机回环自检发现）。
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# --- FreeRTOS 运行时可观测（console ps/task 列表必需）---
# R1 复核 R-13：此前靠开发者本机未入库的 sdkconfig，第三方从零构建会 undefined vTaskList。
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# --- 任务看门狗：任一下述订阅任务饿死即 panic 重启（P1-07；R-13 教训：必须入库）---
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=3

# --- 可复现构建（2026-11-24 S 线，审查条目 X05-F-06）---
# 此前同一份源码从零构建两次，app 与 bootloader 的 sha256 都不同（镜像里带了编译日期、时间和源文件路径）。
# 打开后日期、时间、路径都不再进镜像；调试需要的路径映射由构建自动写进 build/.gdbinit。
# 现场档的 sdkconfig.site 是本地文件，要重新生成一次才带上这一项。
CONFIG_APP_REPRODUCIBLE_BUILD=y

# --- 现场故障证据（2026-11-25 S 线，审查条目 X04-F-03）---
# 此前是 IDF 默认的 ENABLE_TO_NONE：panic / 看门狗 / 欠压复位后设备重启继续工作，事后从设备里
# 读不到任何现场。打开后 panic 处理路径先把核心转储写进 flash 的 coredump 分区再重启。
# 需要 partitions-16mb.csv 里有 coredump 分区。分区表是随整片烧录写入的：只经网页 OTA 升级的设备
# 仍是旧分区表，没有这个分区——IDF 只在启动日志里报一条 "No core dump partition found"，照常运行。
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# 其余取 IDF 默认：ELF 格式、CRC32 校验、启动时校验、最多 64 个任务。
# 导出用的专用栈：本工程开着 FREERTOS_TASK_CREATE_ALLOW_EXT_MEM（SPIRAM 的 Kconfig 默认带出来的），
# IDF 据此默认启用专用栈并要求 STACK_SIZE > 0（为 0 时编译报错）。写死 1792 是把"用哪块栈跑导出"
# 钉住，不随 Kconfig 默认值漂；代价是 1.8 KB 内部 RAM。
CONFIG_ESP_COREDUMP_STACK_SIZE=1792
