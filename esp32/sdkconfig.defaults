# ===== S3-N16R8 模板(16MB Flash + 8MB Octal PSRAM + WiFi/BLE)=====
# 复制为工程根 sdkconfig.defaults;改配置只改这里,不手改 sdkconfig 生成物

# --- Flash 16MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM 8MB Octal(R8=八角 SPI;选 QUAD 会探测失败)---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# --- 控制台走 USB-Serial-JTAG(免驱)---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- 自定义分区表(16MB)---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16mb.csv"

# --- WiFi + BLE 共存 ---
CONFIG_ESP_COEX_ENABLED=y

# --- BLE 用 NimBLE(S3 无经典蓝牙,省 RAM)---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
