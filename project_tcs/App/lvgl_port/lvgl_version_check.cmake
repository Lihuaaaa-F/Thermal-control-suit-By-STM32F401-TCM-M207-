# lvgl_version_check.cmake — TL-16 版本锁：pinned vs vendored lv_version.h，红=构建失败
file(READ "${CMAKE_CURRENT_LIST_DIR}/LVGL_PINNED_VERSION" LVGL_PINNED_VERSION)
string(STRIP "${LVGL_PINNED_VERSION}" LVGL_PINNED_VERSION)
set(VH "${CMAKE_CURRENT_SOURCE_DIR}/third_party/lvgl/include/lvgl/lv_version.h")
file(READ "${VH}" VER_TXT)
foreach(k MAJOR MINOR PATCH)
    string(REGEX MATCH "#define LVGL_VERSION_${k} ([0-9]+)" _ "${VER_TXT}")
    set(LVGL_VERSION_${k} ${CMAKE_MATCH_1})
endforeach()
set(GOT "${LVGL_VERSION_MAJOR}.${LVGL_VERSION_MINOR}.${LVGL_VERSION_PATCH}")
if(NOT GOT STREQUAL LVGL_PINNED_VERSION)
    message(FATAL_ERROR "TL-16 RED: vendored LVGL ${GOT} != pinned ${LVGL_PINNED_VERSION}（版本漂移，禁构建）")
endif()
message(STATUS "TL-16 GREEN: LVGL ${GOT} == pinned ${LVGL_PINNED_VERSION}")
